[Unit]
Description=Ploos Appliance Platform Agent
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/data

[Service]
Type=oneshot
RuntimeDirectory=netns
RuntimeDirectoryMode=0755
ExecStart=/usr/local/lib/ploos-appliance/agent
ExecStop=/usr/local/bin/ploos-appliance stop
RemainAfterExit=yes
TimeoutStartSec=120
TimeoutStopSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/data
ReadWritePaths=-/var/lib/containers
ReadWritePaths=-/run/containers
ReadWritePaths=-/run/libpod
ReadWritePaths=/run/lock
ReadWritePaths=/run/netns

[Install]
WantedBy=multi-user.target
